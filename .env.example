# Server
PORT=3000
NODE_ENV=development

# API Authentication (REQUIRED — shared secret for n8n to authenticate requests)
API_KEY=your-api-key-here

# OCR Service
OCR_SERVICE_URL=https://ocr.unicatsolutions.de/extract-text
OCR_TIMEOUT_MS=60000

# Ollama / LLM Service
OLLAMA_URL=https://ollama.unicatsolutions.de/api/chat/completions
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TOKEN=your-ollama-token-here
OLLAMA_TIMEOUT_MS=120000

# Supabase
SUPABASE_URL=https://supabase.bosavertrieb.de
SUPABASE_KEY=your-supabase-service-role-key-here
SUPABASE_BUCKET=Bosa-Vertrieb

# Logging
LOG_LEVEL=info

# GlitchTip / Sentry error tracking (optional — leave blank to disable)
GLITCHTIP_DSN=
